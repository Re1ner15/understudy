# ==============================================================================
# Understudy Agent - Production Environment Variables
# ==============================================================================

# Google GenAI / Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Google Cloud Firestore Configuration
# When deploying to production with real Firestore, set USE_REAL_FIRESTORE=true
# and leave FIRESTORE_EMULATOR_HOST empty or unset.
USE_REAL_FIRESTORE=true
FIRESTORE_EMULATOR_HOST=

# Slack Integration (Optional for Nudges & Bot Actions)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token
# SLACK_CHANNEL_ID=C0123456789

# Server Configuration
PORT=8080
MOCK_AGENT=false
